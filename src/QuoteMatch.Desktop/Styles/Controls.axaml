<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:QuoteMatch.Desktop.Controls">
  <Style Selector="Window">
    <Setter Property="FontFamily" Value="Segoe UI, Inter, Arial, sans-serif" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    <Setter Property="Background" Value="{DynamicResource CanvasBrush}" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  </Style>
  <Style Selector="TextBlock.columnHeader">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  </Style>
  <Style Selector="Button.compact">
    <Setter Property="Padding" Value="10,6" />
  </Style>
  <Style Selector="Button.comparisonToggle">
    <Setter Property="Padding" Value="0,6" />
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>
  <Style Selector="Border.comparisonGroup">
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
  </Style>
  <Style Selector="Border.comparisonOffer">
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="2,0,0,1" />
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
  </Style>
  <Style Selector="Border.comparisonOffer.recommended">
    <Setter Property="BorderBrush" Value="{DynamicResource PositiveBrush}" />
    <Setter Property="Background" Value="{DynamicResource PositiveSurfaceBrush}" />
  </Style>
  <Style Selector="Border.comparisonOffer:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="ListBox.comparisonList ListBoxItem /template/ ContentPresenter">
    <Setter Property="CornerRadius" Value="0" />
  </Style>
  <Style Selector="ListBox.comparisonList ListBoxItem:selected Border.comparisonGroup">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="TextBlock.bestPrice">
    <Setter Property="Foreground" Value="{DynamicResource PositiveBrush}" />
  </Style>
  <Style Selector="TextBlock.higherPrice">
    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
  </Style>
  <Style Selector="c|HelpLabel.increase TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
  </Style>
  <Style Selector="c|HelpLabel.higherPrice TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
  </Style>
  <Style Selector="c|HelpLabel.decrease TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource PositiveBrush}" />
  </Style>
  <Style Selector="TextBlock.eyebrow">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="1.4" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  </Style>
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="22" />
  </Style>
  <Style Selector="Button">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Padding" Value="14,9" />
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.help">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Margin" Value="0,-3,0,0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ListBox.roundedList">
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="ListBox.roundedList ListBoxItem">
    <Setter Property="Margin" Value="2" />
  </Style>
  <Style Selector="ListBox.roundedList ListBoxItem /template/ ContentPresenter">
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="ListBox.denseList ListBoxItem">
    <Setter Property="MinHeight" Value="36" />
  </Style>
  <Style Selector="ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="MinHeight" Value="50" />
  </Style>
  <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource InkBrush}" />
  </Style>
  <Style Selector="Border.offerCard">
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
  </Style>
  <Style Selector="Border.selectableCard">
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>
  <Style Selector="Border.priceBadge">
    <Setter Property="Background" Value="{DynamicResource PositiveSurfaceBrush}" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="8,4" />
  </Style>
  <Style Selector="TextBlock.selectedMarker">
    <Setter Property="IsVisible" Value="False" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="ListBox.selectableCards ListBoxItem /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>
  <Style Selector="ListBox.selectableCards ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.selectableCards ListBoxItem:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.selectableCards ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.selectableCards ListBoxItem:pointerover Border.selectableCard">
    <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
  </Style>
  <Style Selector="ListBox.selectableCards ListBoxItem:selected Border.selectableCard">
    <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="ListBox.selectableCards ListBoxItem:selected TextBlock.selectedMarker">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector="Border.offerCard.recommended">
    <Setter Property="BorderBrush" Value="{DynamicResource PositiveBrush}" />
    <Setter Property="Background" Value="{DynamicResource PositiveSurfaceBrush}" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="ToolTip">
    <Setter Property="MaxWidth" Value="330" />
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
  </Style>
  <Style Selector="ToolTip TextBlock">
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
</Styles>

