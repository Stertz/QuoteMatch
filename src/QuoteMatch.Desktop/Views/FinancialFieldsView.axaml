<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:QuoteMatch.Desktop.ViewModels" x:Class="QuoteMatch.Desktop.Views.FinancialFieldsView" x:DataType="vm:FinancialFieldsViewModel">
  <ItemsControl ItemsSource="{Binding Fields}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:FinancialFieldRow"><Grid ColumnDefinitions="*,140" ColumnSpacing="10" Margin="0,3"><TextBlock Text="{Binding Label}" VerticalAlignment="Center" /><TextBox Grid.Column="1" Text="{Binding Text}" IsReadOnly="{Binding IsReadOnly}" AutomationProperties.Name="{Binding Label}" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
</UserControl>
